---
import { getCollection } from "astro:content";
import { Mail, MapPin, ArrowRight } from "lucide-react";
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";
import FacebookIcon from "./icons/FacebookIcon.astro";
import InstagramIcon from "./icons/InstagramIcon.astro";
import { contato } from "../lib/contato";

const maravilhas = (await getCollection("maravilhas")).sort((a, b) => a.data.ordem - b.data.ordem);

const navegacao = [
  { label: "Home", href: "/" },
  { label: "Sobre", href: "/sobre-nos" },
  { label: "Maravilhas", href: "/maravilhas" },
  { label: "Equipe", href: "/equipe" },
  { label: "Blog", href: "/blog" },
  { label: "Fale conosco", href: "/fale-conosco" },
];

const anoAtual = new Date().getFullYear();
---

<footer class="footer">
  <div class="mx-auto max-w-7xl px-4 py-14 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Marca -->
      <div>
        <Image src={logo} alt="Maravilhas do Mundo" width={212} height={34} class="mb-4 h-9 w-auto" />
        <p class="max-w-xs text-sm leading-relaxed text-branco/90">
          Histórias, curiosidades e coordenadas das Sete Maravilhas do Mundo Moderno, em quatro continentes.
        </p>
        {(contato.facebook || contato.instagram) && (
          <div class="mt-5 flex gap-3">
            {contato.facebook && (
              <a
                href={contato.facebook}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook do Maravilhas do Mundo"
                class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-[var(--raio)] border border-branco/25 text-branco transition-colors duration-200 hover:border-ouro-claro hover:text-ouro-claro"
              >
                <FacebookIcon class="h-4 w-4" />
              </a>
            )}
            {contato.instagram && (
              <a
                href={contato.instagram}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram do Maravilhas do Mundo"
                class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-[var(--raio)] border border-branco/25 text-branco transition-colors duration-200 hover:border-ouro-claro hover:text-ouro-claro"
              >
                <InstagramIcon class="h-4 w-4" />
              </a>
            )}
          </div>
        )}
      </div>

      <!-- Navegação -->
      <nav aria-label="Navegação do rodapé">
        <p class="footer-title mb-4 text-xs font-extrabold uppercase tracking-[0.18em]">Navegação</p>
        <ul class="space-y-2.5">
          {navegacao.map((l) => (
            <li>
              <a
                href={l.href}
                class="cursor-pointer text-sm text-branco/90 transition-colors duration-200 hover:text-branco"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Maravilhas -->
      <div>
        <p class="footer-title mb-4 text-xs font-extrabold uppercase tracking-[0.18em]">Maravilhas</p>
        <ul class="space-y-3.5">
          {maravilhas.map((m) => (
            <li class="text-sm leading-snug">
              <a
                href={`/#maravilha-${m.data.id}`}
                class="cursor-pointer font-semibold text-branco transition-colors duration-200 hover:text-ouro-claro"
              >
                {m.data.nome}
              </a>
              <br />
              <span class="text-xs text-branco/75">{m.data.local} · {m.data.pais}</span>
              {(m.data.facebook || m.data.instagram) && (
                <span class="mt-1 flex gap-3">
                  {m.data.facebook && (
                    <a
                      href={m.data.facebook}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Facebook de ${m.data.nome}`}
                      class="cursor-pointer text-branco/80 transition-colors duration-200 hover:text-ouro-claro"
                    >
                      <FacebookIcon class="h-3.5 w-3.5" />
                    </a>
                  )}
                  {m.data.instagram && (
                    <a
                      href={m.data.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Instagram de ${m.data.nome}`}
                      class="cursor-pointer text-branco/80 transition-colors duration-200 hover:text-ouro-claro"
                    >
                      <InstagramIcon class="h-3.5 w-3.5" />
                    </a>
                  )}
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Contato / CTA -->
      <div>
        <p class="footer-title mb-4 text-xs font-extrabold uppercase tracking-[0.18em]">Fale com a gente</p>

        {contato.email && (
          <a
            href={`mailto:${contato.email}`}
            class="mb-3 flex cursor-pointer items-start gap-2.5 text-sm text-branco/90 transition-colors duration-200 hover:text-branco"
          >
            <Mail className="mt-0.5 h-4 w-4 shrink-0 text-ouro-claro" aria-hidden="true" />
            <span class="break-all">{contato.email}</span>
          </a>
        )}

        <a
          href="/#maravilhas"
          class="mb-5 flex cursor-pointer items-start gap-2.5 text-sm text-branco/90 transition-colors duration-200 hover:text-branco"
        >
          <MapPin className="mt-0.5 h-4 w-4 shrink-0 text-ouro-claro" aria-hidden="true" />
          <span>Ver todas as maravilhas no mapa</span>
        </a>

        <a
          href="/fale-conosco"
          class="mb-2.5 flex cursor-pointer items-center justify-center gap-2 rounded-[var(--raio)] border-2 border-ouro-claro px-4 py-2.5 text-sm font-bold text-ouro-claro transition-colors duration-200 hover:bg-ouro-claro hover:text-rodape"
        >
          Fale conosco
        </a>
        <a
          href="#bookform1"
          data-booking-trigger
          class="flex cursor-pointer items-center justify-center gap-2 rounded-[var(--raio)] bg-cta px-4 py-3 text-sm font-bold text-texto transition-all duration-200 hover:brightness-95"
        >
          Planeje sua visita
          <ArrowRight className="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>

  <!-- Barra inferior -->
  <div class="border-t border-branco/10">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-6 text-center text-xs text-branco/75 md:flex-row md:text-left lg:px-8"
    >
      <p>© {anoAtual} Maravilhas do Mundo. Todos os direitos reservados.</p>
      <p>Desenvolvido por <span class="font-semibold text-branco/90">Ícaro Carneiro</span></p>
    </div>
  </div>
</footer>
