---
import { getCollection } from "astro:content";
import { Mail } from "lucide-react";
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";
import FacebookIcon from "./icons/FacebookIcon.astro";
import InstagramIcon from "./icons/InstagramIcon.astro";

const unidades = (await getCollection("unidades")).sort((a, b) => a.data.ordem - b.data.ordem);

const mapaUnidade = unidades.find((u) => u.data.mapaEmbed);
const mapaSrc = mapaUnidade?.data.coordenadas
  ? `https://maps.google.com/maps?q=${mapaUnidade.data.coordenadas.lat},${mapaUnidade.data.coordenadas.lng}&z=15&output=embed`
  : null;

const mapaDoSite = [
  { label: "Home", href: "/" },
  { label: "Sobre Nos", href: "/sobre-nos" },
  { label: "Servicos", href: "/servicos" },
  { label: "Blog", href: "/blog" },
  { label: "Fale Conosco", href: "/fale-conosco" },
  { label: "Agende sua Consulta", href: "#bookform1" },
];

const anoAtual = new Date().getFullYear();
---

<footer class="footer">
  <div class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
    <div class="grid gap-10 md:grid-cols-[1.2fr_1fr_1.6fr]">
      <div>
        <div class="mb-4 rounded-md bg-branco/5 p-2 inline-flex">
          <Image src={logo} alt="Correia Odontologia" width={212} height={34} />
        </div>
        <p class="footer-title mb-2 text-sm font-extrabold uppercase tracking-wide">Mapa do site</p>
        <ul class="space-y-1.5 text-sm text-branco/85">
          {mapaDoSite.map((item) => (
            <li>
              <a href={item.href} class="cursor-pointer transition-colors duration-200 hover:text-primaria" data-booking-trigger={item.href === "#bookform1" ? true : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-6 flex items-center gap-3">
          <a href="https://www.facebook.com/clinica.correia" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="cursor-pointer text-branco/85 transition-colors duration-200 hover:text-primaria">
            <FacebookIcon class="h-5 w-5" />
          </a>
          <a href="https://www.instagram.com/clinica.correia/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="cursor-pointer text-branco/85 transition-colors duration-200 hover:text-primaria">
            <InstagramIcon class="h-5 w-5" />
          </a>
          <a href="mailto:agendamento@correiaodontologia.com.br" aria-label="E-mail" class="cursor-pointer text-branco/85 transition-colors duration-200 hover:text-primaria">
            <Mail className="h-5 w-5" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div>
        <p class="footer-title mb-3 text-sm font-extrabold uppercase tracking-wide">Contatos</p>
        <ul class="space-y-5 text-sm text-branco/85">
          {unidades.map((u) => (
            <li>
              <p class="font-bold text-branco">{u.data.cidade}</p>
              <p>Tel {u.data.telefone} · WhatsApp {u.data.whatsapp}</p>
              <p class="text-branco/70">{u.data.horarios}</p>
              <p class="text-branco/70">{u.data.endereco}</p>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="footer-title mb-3 text-sm font-extrabold uppercase tracking-wide">Onde estamos</p>
        {mapaSrc && (
          <div class="overflow-hidden rounded-[var(--raio)] border border-branco/10">
            <iframe
              src={mapaSrc}
              width="100%"
              height="220"
              style="border:0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Mapa — Correia Odontologia, Santa Fé do Sul"
            ></iframe>
          </div>
        )}
        <p class="mt-4 text-sm text-branco/85">
          <a href="mailto:agendamento@correiaodontologia.com.br" class="cursor-pointer inline-flex items-center gap-1.5 transition-colors duration-200 hover:text-primaria">
            <Mail className="h-4 w-4" aria-hidden="true" />
            agendamento@correiaodontologia.com.br
          </a>
        </p>
      </div>
    </div>

    <hr class="my-8 border-branco/15" />

    <div class="flex flex-col gap-2 text-xs text-branco/70 md:flex-row md:items-center md:justify-between">
      <p>
        © {anoAtual} | Todos os direitos reservados | Correia Odontologia CRO-SP: 20.917 RT Dra. Leticia S. M. Correia CRO/SP 129.476
      </p>
      <p>Desenvolvimento: Ícaro Carneiro</p>
    </div>
  </div>
</footer>
