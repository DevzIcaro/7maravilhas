---
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";

const links = [
  { label: "HOME", href: "/" },
  { label: "SOBRE NÓS", href: "/sobre-nos" },
  { label: "SERVIÇOS", href: "/servicos" },
  { label: "FALE CONOSCO", href: "/fale-conosco" },
  { label: "BLOG", href: "/blog" },
];

const current = new URL(Astro.request.url).pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-borda bg-branco/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3 lg:px-8">
    <a href="/" class="flex items-center cursor-pointer" aria-label="Correia Odontologia — página inicial">
      <Image src={logo} alt="Correia Odontologia" width={225} height={36} />
    </a>

    <nav aria-label="Navegação principal" class="hidden md:block">
      <ul class="flex items-center gap-7 text-sm font-bold tracking-wide text-texto">
        {links.map((link) => {
          const active = current === link.href;
          return (
            <li>
              <a
                href={link.href}
                class:list={[
                  "cursor-pointer transition-colors duration-200 hover:text-primaria",
                  active ? "text-primaria" : "text-texto",
                ]}
                aria-current={active ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <a href="#bookform1" class="btn btn-cta hidden md:inline-flex" data-booking-trigger>
      + Agende uma consulta
    </a>

    <details class="relative md:hidden">
      <summary class="btn btn-outline cursor-pointer list-none !px-3">Menu</summary>
      <ul class="absolute right-0 z-50 mt-2 w-56 space-y-1 rounded-[var(--raio)] border border-borda bg-branco p-3 shadow-lg">
        {links.map((link) => (
          <li>
            <a href={link.href} class="block cursor-pointer rounded px-2 py-2 text-sm font-bold text-texto transition-colors duration-200 hover:bg-superficie hover:text-primaria">
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href="#bookform1" class="btn btn-cta mt-1 w-full justify-center" data-booking-trigger>
            + Agende uma consulta
          </a>
        </li>
      </ul>
    </details>
  </div>
</header>
