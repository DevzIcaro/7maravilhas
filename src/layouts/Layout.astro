---
import { url } from "../lib/url";
import { getCollection } from "astro:content";
import faviconSvg from "../assets/favicon.svg?url";
import favicon16 from "../assets/favicon-16x16.png?url";
import favicon32 from "../assets/favicon-32x32.png?url";
import favicon96 from "../assets/favicon-96x96.png?url";
import appleTouchIcon from "../assets/apple-touch-icon.png?url";
import logoUrl from "../assets/logo.svg?url";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import CTAAgende from "../components/CTAAgende.astro";
import BookingModal from "../components/BookingModal";
import { contato } from "../lib/contato";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = "/" } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://devzicaro.github.io";
const siteRoot = siteUrl + url("/").replace(/\/$/, "");
const canonical = siteRoot + (path === "/" ? "/" : path);
const ogImage = `${siteRoot}/og-image.jpg`;

const maravilhas = (await getCollection("maravilhas")).sort((a, b) => a.data.ordem - b.data.ordem);

const SITE_NOME = "Maravilhas do Mundo";
const sameAs = [contato.facebook, contato.instagram].filter((link): link is string => Boolean(link));

const jsonLdOrganization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteRoot}/#organizacao`,
  name: SITE_NOME,
  url: siteRoot,
  logo: `${siteRoot}/logo.png`,
  ...(sameAs.length ? { sameAs } : {}),
};

const jsonLdAtracoes = maravilhas.map((m) => ({
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "@id": `${siteRoot}/#maravilha-${m.data.id}`,
  name: m.data.nome,
  description: m.data.descricao,
  address: {
    "@type": "PostalAddress",
    addressLocality: m.data.local,
    addressCountry: m.data.pais,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: m.data.coordenadas.lat,
    longitude: m.data.coordenadas.lng,
  },
  ...(m.data.facebook || m.data.instagram
    ? { sameAs: [m.data.facebook, m.data.instagram].filter(Boolean) }
    : {}),
}));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/x-icon" href={url("/favicon.ico?v=2")} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16} />
    <link rel="icon" type="image/png" sizes="96x96" href={favicon96} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} />
    <link rel="manifest" href={url("/site.webmanifest?v=2")} />
    <meta name="theme-color" content="#9a7526" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE_NOME} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrganization)} />
    {jsonLdAtracoes.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}

    <noscript><style>[data-reveal] > * { opacity: 1; }</style></noscript>
  </head>
  <body>
    <Navbar
      client:load
      logoSrc={logoUrl}
      maravilhas={maravilhas.map((m) => ({ id: m.data.id, nome: m.data.nome, pais: m.data.pais, local: m.data.local }))}
    />
    <main>
      <slot />
    </main>
    <CTAAgende />
    <Footer />
    <BookingModal
      client:load
      maravilhas={maravilhas.map((m) => ({ id: m.data.id, nome: m.data.nome, pais: m.data.pais }))}
    />
  </body>
</html>
