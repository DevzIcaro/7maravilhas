---
import { url } from "../../../../lib/url";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../../../layouts/Layout.astro";
import PlaceholderImage from "../../../../components/PlaceholderImage.astro";
import { imagemDoPost } from "../../../../lib/postImagens";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((p) => ({
    params: { id: p.data.id, slug: p.data.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const imagem = imagemDoPost(post.data.id);

const formatarData = (d: Date) =>
  new Intl.DateTimeFormat("pt-BR", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" }).format(d);
---

<Layout title={`${post.data.titulo} — Blog Maravilhas do Mundo`} description={post.data.resumo} path={`/blog/ver/${post.data.id}/${post.data.slug}`}>
  <article class="mx-auto max-w-3xl px-4 py-10 lg:px-8">
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-texto/60">
      <a href={url("/")} class="cursor-pointer hover:text-primaria">Home</a> <span aria-hidden="true">›</span>
      <a href={url("/blog")} class="cursor-pointer hover:text-primaria">Blog</a> <span aria-hidden="true">›</span> {post.data.titulo}
    </nav>

    {imagem ? (
      <Image
        src={imagem}
        alt={post.data.titulo}
        widths={[480, 768, 1024]}
        sizes="(max-width: 768px) 100vw, 768px"
        loading="eager"
        decoding="async"
        class="mb-8 aspect-video w-full rounded-[var(--raio)] object-cover"
      />
    ) : (
      <PlaceholderImage alt={post.data.titulo} ratio="wide" class="mb-8" />
    )}

    <h1 class="section-title">{post.data.titulo}</h1>
    <p class="mb-8 text-sm text-texto/60">
      {formatarData(post.data.data)} · {post.data.autor}
    </p>

    <div class="space-y-4 text-texto">
      {post.data.corpo.map((bloco) => {
        if (bloco.type === "h2") return <h2 class="pt-4 text-xl font-extrabold text-secundaria-forte">{bloco.text}</h2>;
        if (bloco.type === "p") return <p>{bloco.text}</p>;
        return (
          <ul class="list-disc space-y-1.5 pl-6">
            {bloco.items.map((item) => <li>{item}</li>)}
          </ul>
        );
      })}
    </div>

    <a href={url("/blog")} class="btn btn-outline mt-10 cursor-pointer">Voltar ao blog</a>
  </article>
</Layout>
