---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { User, Phone, Mail, MapPin, Building2, Calendar, Clock, ChevronDown, MessageCircle, Copy, Check, ArrowUp } from "lucide-react";
import FacebookIcon from "../components/icons/FacebookIcon.astro";
import InstagramIcon from "../components/icons/InstagramIcon.astro";
import { linkTelefone, linkWhatsapp, linkMaps } from "../lib/unidadeLinks";

const TELEFONE = "(17) 3641-0544";
const WHATSAPP = "(17) 99717-8758";
const ENDERECO = "Rua 17, nº 996 - Centro, Santa Fé do Sul - SP";
const EMAIL = "contato@correiaodontologia.com.br";

// Select de unidade do formulário: envia pelo WhatsApp real de cada unidade.
const unidades = (await getCollection("unidades")).sort((a, b) => a.data.ordem - b.data.ordem);
---

<Layout
  title="Fale Conosco — Correia Odontologia"
  description="Entre em contato com a Correia Odontologia: telefone, WhatsApp, e-mail e formulário de atendimento das clínicas em Santa Fé do Sul, Jales, Rio Preto, Votuporanga e Três Lagoas."
  path="/fale-conosco"
>
  <section class="mx-auto max-w-7xl px-4 py-10 lg:px-8">
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-texto/60">
      <a href="/" class="cursor-pointer hover:text-primaria">Home</a> <span aria-hidden="true">›</span> Fale Conosco
    </nav>
    <h1 class="section-title">Fale Conosco</h1>

    <div class="mb-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div class="card flex items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-secundaria/10 text-secundaria">
          <Phone className="h-5 w-5" aria-hidden="true" />
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-xs font-bold uppercase tracking-wide text-texto/60">Telefone</p>
          <p class="truncate text-sm font-semibold text-texto">{TELEFONE}</p>
        </div>
        <a
          href={linkTelefone(TELEFONE)}
          aria-label={`Ligar para ${TELEFONE}`}
          class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-secundaria transition-colors duration-200 hover:bg-secundaria/10"
        >
          <Phone className="h-4 w-4" aria-hidden="true" />
        </a>
        <button
          type="button"
          data-copiar={TELEFONE}
          aria-label={`Copiar número ${TELEFONE}`}
          class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-secundaria transition-colors duration-200 hover:bg-secundaria/10"
        >
          <Copy className="h-4 w-4" aria-hidden="true" data-icone-copiar />
          <Check className="hidden h-4 w-4" aria-hidden="true" data-icone-copiado />
        </button>
      </div>

      <a
        href={linkWhatsapp(WHATSAPP, "Olá! Gostaria de falar com a Correia Odontologia.")}
        target="_blank"
        rel="noopener noreferrer"
        class="card flex cursor-pointer items-center gap-3"
      >
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#25D366]/10 text-[#25D366]">
          <MessageCircle className="h-5 w-5" aria-hidden="true" />
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-xs font-bold uppercase tracking-wide text-texto/60">WhatsApp</p>
          <p class="truncate text-sm font-semibold text-texto">{WHATSAPP}</p>
        </div>
      </a>

      <a
        href={linkMaps({ endereco: ENDERECO, coordenadas: null })}
        target="_blank"
        rel="noopener noreferrer"
        class="card flex cursor-pointer items-center gap-3"
      >
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#EA4335]/10 text-[#EA4335]">
          <MapPin className="h-5 w-5" aria-hidden="true" />
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-xs font-bold uppercase tracking-wide text-texto/60">Endereço</p>
          <p class="truncate text-sm font-semibold text-texto">{ENDERECO}</p>
        </div>
      </a>

      <a href={`mailto:${EMAIL}`} class="card flex cursor-pointer items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primaria/10 text-primaria">
          <Mail className="h-5 w-5" aria-hidden="true" />
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-xs font-bold uppercase tracking-wide text-texto/60">E-mail</p>
          <p class="truncate text-sm font-semibold text-texto">{EMAIL}</p>
        </div>
      </a>

      <a
        href="https://www.facebook.com/clinica.correia"
        target="_blank"
        rel="noopener noreferrer"
        class="card flex cursor-pointer items-center gap-3"
      >
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#1877F2]/10 text-[#1877F2]">
          <FacebookIcon class="h-5 w-5" />
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-xs font-bold uppercase tracking-wide text-texto/60">Facebook</p>
          <p class="truncate text-sm font-semibold text-texto">clinica.correia</p>
        </div>
      </a>

      <a
        href="https://www.instagram.com/clinica.correia/"
        target="_blank"
        rel="noopener noreferrer"
        class="card flex cursor-pointer items-center gap-3"
      >
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[linear-gradient(45deg,#feda75,#fa7e1e,#d62976,#962fbf,#4f5bd5)] text-white">
          <InstagramIcon class="h-5 w-5" />
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-xs font-bold uppercase tracking-wide text-texto/60">Instagram</p>
          <p class="truncate text-sm font-semibold text-texto">@clinica.correia</p>
        </div>
      </a>
    </div>

    <div class="rounded-[var(--raio)] border border-borda p-6 md:p-10">
      <h2 class="text-xl font-extrabold text-secundaria-forte">FALE CONOSCO</h2>
      <p class="section-subtitle mb-8">Deixe seus dados de contato pra gente falar com você :)</p>

      <form class="grid gap-6 md:grid-cols-2" id="fale-conosco-form">
        <div class="space-y-4">
          <div>
            <label for="fc-unidade" class="mb-1 block text-sm font-bold text-texto">Unidade</label>
            <div class="relative">
              <Building2 className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-secundaria" aria-hidden="true" />
              <select id="fc-unidade" name="unidade" required class="field appearance-none pl-9 pr-9">
                <option value="" selected disabled>Escolha a unidade</option>
                {unidades.map((u) => (
                  <option value={u.data.id} data-whatsapp={u.data.whatsapp}>
                    {u.data.cidade}{u.data.uf === "MS" ? " - MS" : ""}
                  </option>
                ))}
                {/* Opção só para teste do fluxo — remover antes de publicar */}
                <option value="teste" data-whatsapp="(17) 99264-1230">Teste (Ícaro)</option>
              </select>
              <ChevronDown className="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-secundaria" aria-hidden="true" />
            </div>
          </div>
          <div>
            <label for="fc-nome" class="mb-1 block text-sm font-bold text-texto">Seu nome</label>
            <div class="relative">
              <User className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-secundaria" aria-hidden="true" />
              <input
                id="fc-nome"
                name="nome"
                type="text"
                required
                maxlength="80"
                autocomplete="name"
                placeholder="Seu nome"
                class="field pl-9"
              />
            </div>
          </div>
          <div>
            <label for="fc-telefone" class="mb-1 block text-sm font-bold text-texto">Telefone</label>
            <div class="relative">
              <Phone className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-secundaria" aria-hidden="true" />
              <input
                id="fc-telefone"
                name="telefone"
                type="tel"
                required
                inputmode="numeric"
                autocomplete="tel"
                maxlength="11"
                pattern="[0-9]{8,11}"
                placeholder="Telefone (somente números)"
                class="field pl-9"
              />
            </div>
          </div>
          <div>
            <label for="fc-email" class="mb-1 block text-sm font-bold text-texto">E-mail</label>
            <div class="relative">
              <Mail className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-secundaria" aria-hidden="true" />
              <input
                id="fc-email"
                name="email"
                type="email"
                required
                inputmode="email"
                autocomplete="email"
                maxlength="120"
                placeholder="E-mail"
                class="field pl-9"
              />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="fc-data" class="mb-1 block text-sm font-bold text-texto">Data desejada</label>
              <div class="relative">
                <Calendar className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-secundaria" aria-hidden="true" />
                <input id="fc-data" name="data" type="date" required autocomplete="off" class="field pl-9" />
              </div>
            </div>
            <div>
              <label for="fc-horario" class="mb-1 block text-sm font-bold text-texto">Horário</label>
              <div class="relative">
                <Clock className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-secundaria" aria-hidden="true" />
                <input id="fc-horario" name="horario" type="time" required autocomplete="off" class="field pl-9" />
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-col">
          <label for="fc-mensagem" class="mb-1 block text-sm font-bold text-texto">Sua mensagem</label>
          <textarea id="fc-mensagem" name="mensagem" placeholder="Sua mensagem.." class="field h-full min-h-[9.5rem]"></textarea>
        </div>

        <div class="md:col-span-2">
          {/* Site key de TESTE pública do Google (sempre valida, uso só em dev).
               [A CONFIRMAR] trocar por data-sitekey real da Correia antes de publicar:
               https://www.google.com/recaptcha/admin — registrar o domínio, tipo v2 "Caixa de seleção". */}
          <div id="fc-recaptcha" class="g-recaptcha mb-6" data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"></div>
          <button type="submit" class="btn btn-cta">
            <MessageCircle className="h-4 w-4" aria-hidden="true" />
            Enviar pelo WhatsApp
          </button>
          <p id="fc-status" class="mt-3 hidden text-sm font-semibold text-[#EA4335]" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>

  <button
    type="button"
    id="voltar-topo"
    aria-label="Voltar ao topo"
    class="fixed bottom-6 right-6 z-30 hidden cursor-pointer items-center justify-center rounded-full bg-cta p-3 text-texto shadow-lg transition-colors duration-200 hover:bg-[var(--cor-cta-hover)] focus-visible:outline-3"
  >
    <ArrowUp className="h-5 w-5" aria-hidden="true" />
  </button>

  {/* Script do reCAPTCHA carrega globalmente pelo Layout.astro (também usado pelo BookingModal). */}
  <script>
    import { linkWhatsapp } from "../lib/unidadeLinks";

    declare global {
      interface Window {
        grecaptcha?: { getResponse(widget?: number): string; reset(widget?: number): void };
      }
    }

    const btn = document.getElementById("voltar-topo");
    const toggle = () => {
      if (!btn) return;
      const show = window.scrollY > 400;
      btn.classList.toggle("hidden", !show);
      btn.classList.toggle("flex", show);
    };
    window.addEventListener("scroll", toggle, { passive: true });
    btn?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
    toggle();

    const form = document.getElementById("fale-conosco-form") as HTMLFormElement | null;

    // Data mínima do campo "Data desejada" = hoje (calculado no navegador, nunca no build).
    const dataInput = document.getElementById("fc-data") as HTMLInputElement | null;
    if (dataInput) dataInput.min = new Date().toISOString().slice(0, 10);

    // Telefone só aceita dígitos — remove qualquer outro caractere digitado.
    const telefoneInput = document.getElementById("fc-telefone") as HTMLInputElement | null;
    telefoneInput?.addEventListener("input", () => {
      telefoneInput.value = telefoneInput.value.replace(/\D/g, "");
    });

    // Leitura tipada de FormData — evita `string | File | null` solto pelo código.
    function campo(dados: FormData, nome: string): string {
      const valor = dados.get(nome);
      return typeof valor === "string" ? valor.trim() : "";
    }

    // Rate limit de envio: 5 tentativas por dia por navegador, evita sobrecarregar
    // o WhatsApp da unidade com envios repetidos. É um limite no cliente (sem
    // servidor não dá pra bloquear por IP) — soft-limit contra clique repetido/acidental.
    const LIMITE_TENTATIVAS = 5;
    const CHAVE_TENTATIVAS = "fc-tentativas";

    interface RegistroTentativas {
      data: string;
      quantidade: number;
    }

    function lerTentativas(): RegistroTentativas {
      const hoje = new Date().toISOString().slice(0, 10);
      try {
        const salvo = JSON.parse(localStorage.getItem(CHAVE_TENTATIVAS) ?? "null") as RegistroTentativas | null;
        if (salvo?.data === hoje) return salvo;
      } catch {
        // localStorage indisponível (modo privado etc.) — segue sem persistir limite.
      }
      return { data: hoje, quantidade: 0 };
    }

    function salvarTentativas(registro: RegistroTentativas) {
      try {
        localStorage.setItem(CHAVE_TENTATIVAS, JSON.stringify(registro));
      } catch {
        // idem
      }
    }

    const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const statusEl = document.getElementById("fc-status");

    function mostrarStatus(mensagem: string) {
      if (!statusEl) return;
      statusEl.textContent = mensagem;
      statusEl.classList.remove("hidden");
    }

    function limparStatus() {
      if (!statusEl) return;
      statusEl.textContent = "";
      statusEl.classList.add("hidden");
    }

    function atualizarEstadoLimite(quantidade: number) {
      const esgotado = quantidade >= LIMITE_TENTATIVAS;
      if (submitBtn) submitBtn.disabled = esgotado;
      if (esgotado) mostrarStatus("Limite de tentativas atingido por hoje. Fale direto pelo WhatsApp ou telefone acima.");
    }
    atualizarEstadoLimite(lerTentativas().quantidade);

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      limparStatus();

      const tentativas = lerTentativas();
      if (tentativas.quantidade >= LIMITE_TENTATIVAS) {
        atualizarEstadoLimite(tentativas.quantidade);
        return;
      }

      const captcha = window.grecaptcha?.getResponse();
      if (!captcha) {
        mostrarStatus("Confirme o reCAPTCHA antes de enviar.");
        return;
      }

      const unidade = form.querySelector<HTMLSelectElement>("#fc-unidade")?.selectedOptions[0];
      const whatsapp = unidade?.dataset.whatsapp;
      if (!whatsapp) return;

      const dados = new FormData(form);
      const mensagem = [
        `Olá! Vim pelo site e quero agendar uma consulta na unidade de ${unidade.textContent?.trim()}.`,
        `Nome: ${campo(dados, "nome")}`,
        `Telefone: ${campo(dados, "telefone")}`,
        `E-mail: ${campo(dados, "email")}`,
        `Data desejada: ${campo(dados, "data")}`,
        `Horário desejado: ${campo(dados, "horario")}`,
        campo(dados, "mensagem") ? `Mensagem: ${campo(dados, "mensagem")}` : "",
      ]
        .filter(Boolean)
        .join("\n");

      window.open(linkWhatsapp(whatsapp, mensagem), "_blank", "noopener");
      form.reset();
      window.grecaptcha?.reset();

      const atualizado = { ...tentativas, quantidade: tentativas.quantidade + 1 };
      salvarTentativas(atualizado);
      atualizarEstadoLimite(atualizado.quantidade);
    });

    // Copiar número de telefone fixo (facilita discar em celulares)
    document.querySelectorAll<HTMLButtonElement>("[data-copiar]").forEach((copiarBtn) => {
      const rotuloOriginal = copiarBtn.getAttribute("aria-label") ?? "";
      copiarBtn.addEventListener("click", async () => {
        const numero = copiarBtn.dataset.copiar;
        if (!numero) return;
        await navigator.clipboard.writeText(numero);

        copiarBtn.querySelector("[data-icone-copiar]")?.classList.add("hidden");
        copiarBtn.querySelector("[data-icone-copiado]")?.classList.remove("hidden");
        copiarBtn.setAttribute("aria-label", "Número copiado");

        window.setTimeout(() => {
          copiarBtn.querySelector("[data-icone-copiar]")?.classList.remove("hidden");
          copiarBtn.querySelector("[data-icone-copiado]")?.classList.add("hidden");
          copiarBtn.setAttribute("aria-label", rotuloOriginal);
        }, 1500);
      });
    });
  </script>
</Layout>
