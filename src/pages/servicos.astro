---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import imagemServicos from "../assets/consulta.jpg";
import {
  Stethoscope,
  Syringe,
  Bone,
  Smile,
  SmilePlus,
  Baby,
  Sparkles,
  Move,
  ShieldCheck,
  Gem,
  Sun,
  WandSparkles,
  type LucideIcon,
} from "lucide-react";

const servicos = await getCollection("servicos");

// Ícone por serviço (casa com o id em src/data/servicos.json) — mantido local
// aqui porque só esta página usa; segue o mesmo padrão de lookup por id de
// postImagens.ts/unidadeFotos.ts, sem mexer no schema da coleção.
const icones: Record<string, LucideIcon> = {
  "clinica-geral": Stethoscope,
  "endodontia-tratamento-de-canal": Syringe,
  "implantes-dentarios": Bone,
  "protese-overdenture": Smile,
  "protese-protocolo": SmilePlus,
  odontopediatria: Baby,
  "lentes-de-contato": Sparkles,
  ortodontia: Move,
  periodontia: ShieldCheck,
  "protese-dental": Gem,
  clareamento: Sun,
  "harmonizacao-facial": WandSparkles,
};

const filtros = [
  "Todos",
  "Tratamento de Canal",
  "Implantes Dentários",
  "Odontopediatria",
  "Ortodontia",
  "Lentes de contato",
  "Prótese Dental",
  "Harmonização Facil",
];
---

<Layout
  title="Serviços — Correia Odontologia"
  description="Conheça os serviços da Correia Odontologia: clínica geral, implantes, ortodontia, lentes de contato, próteses e mais, em Santa Fé do Sul, Jales, Rio Preto, Votuporanga e Três Lagoas."
  path="/servicos"
>
  <section class="mx-auto max-w-7xl px-4 py-10 lg:px-8">
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-texto/60">
      <a href="/" class="cursor-pointer hover:text-primaria">Home</a> <span aria-hidden="true">›</span> Serviços
    </nav>
    <h1 class="section-title">Serviços</h1>

    <div class="mb-10 grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <p class="section-subtitle max-w-2xl">
        Na Correia Odontolgia temos profissionais qualificados e equipamentos de ponta, para atender você e sua
        família!
      </p>
      <Image
        src={imagemServicos}
        alt="Atendimento odontológico na Correia Odontologia"
        widths={[480, 640, 880]}
        sizes="(max-width: 1024px) 100vw, 40vw"
        loading="eager"
        decoding="async"
        class="aspect-video w-full rounded-[var(--raio)] object-cover"
      />
    </div>

    <div class="mb-10 flex flex-wrap gap-2" role="group" aria-label="Filtrar serviços por categoria">
      {filtros.map((f, i) => (
        <button
          type="button"
          class="btn btn-outline !py-2 !px-4 !text-xs cursor-pointer"
          data-filtro={f}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {f}
        </button>
      ))}
    </div>

    <div id="lista-servicos" class="grid gap-6 md:grid-cols-2" data-reveal data-reveal-icons>
      {servicos.map((s) => {
        const Icone = icones[s.data.id];
        return (
          <div class="card" data-categoria={s.data.categoria}>
            <div class="mb-3 flex flex-col items-center text-center">
              <span
                data-icone-card
                class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-primaria/10 text-primaria"
              >
                <Icone className="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="text-lg font-bold">{s.data.titulo}</h3>
            </div>
            <p class="mt-2 text-sm text-texto/80">{s.data.descricao}</p>
            {s.data.subitens.length > 0 && (
              <ul class="mt-3 space-y-2 border-l-2 border-borda pl-4">
                {s.data.subitens.map((sub) => (
                  <li>
                    <p class="text-sm font-bold text-secundaria-forte">{sub.titulo}</p>
                    <p class="text-sm text-texto/80">{sub.descricao}</p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <script>
    import { revealOnScroll, popIconsOnScroll, animateFilterSwap } from "../lib/animations";

    revealOnScroll();
    popIconsOnScroll();

    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filtro]");
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#lista-servicos [data-categoria]"));

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filtro = btn.dataset.filtro;
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        animateFilterSwap(cards, (card) => filtro === "Todos" || card.dataset.categoria === filtro);
      });
    });
  </script>
</Layout>
