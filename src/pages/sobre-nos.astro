---
import Layout from "../layouts/Layout.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";

const diferenciais = [
  {
    titulo: "Câmera Intra Oral",
    texto: "Permite ver todos os detalhes que precisam ser feitos em seus dentes, na hora e você confere na TV. Diferentemente dos espelhos convencionais.",
  },
  {
    titulo: "Escolha o Som",
    texto: "Três salas equipadas com TV's no teto e parede, onde você escolhe o que quer assistir e ouvir durante o tratamento!",
  },
  {
    titulo: "Wifi",
    texto: "Navegue enquanto espera",
  },
  {
    titulo: "Conforto",
    texto: "Ambiente aconchegante e climatizado",
  },
];
---

<Layout
  title="Sobre Nós — Correia Odontologia"
  description="Conheça a história da Correia Odontologia e os diferenciais das clínicas em Santa Fé do Sul, Jales, São José do Rio Preto, Votuporanga e Três Lagoas."
  path="/sobre-nos"
>
  <section class="mx-auto max-w-7xl px-4 py-10 lg:px-8">
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-texto/60">
      <a href="/" class="cursor-pointer hover:text-primaria">Home</a> <span aria-hidden="true">›</span> Sobre Nós
    </nav>
    <h1 class="section-title">Sobre Nós</h1>

    <div class="mb-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
      <PlaceholderImage alt="Clínica Correia Odontologia — ambiente 1" ratio="square" />
      <PlaceholderImage alt="Clínica Correia Odontologia — ambiente 2" ratio="square" />
      <PlaceholderImage alt="Clínica Correia Odontologia — ambiente 3" ratio="square" />
      <PlaceholderImage alt="Clínica Correia Odontologia — ambiente 4" ratio="square" />
    </div>

    <p class="max-w-3xl text-texto">
      A Clínica Correia Odontologia surgiu no final de 2018. Temos compromisso constante com excelência em
      atendimento, utilização das técnicas e tecnologias mais modernas da Odontologia e proporcionar uma vida
      mais feliz aos nossos pacientes por meio de um novo sorriso. Oferecemos todos os tipos de tratamentos e
      contamos com nosso grande diferencial: Atendimento humanizado!
    </p>

    <h2 class="section-title mt-14">Diferenciais</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {diferenciais.map((d) => (
        <div class="card">
          <h3 class="text-base font-bold">{d.titulo}</h3>
          <p class="mt-1 text-sm text-texto/80">{d.texto}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
