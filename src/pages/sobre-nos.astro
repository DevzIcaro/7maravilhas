---
import { url } from "../lib/url";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { Map as Mapa, BookOpen, Compass, Landmark } from "lucide-react";
import Layout from "../layouts/Layout.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";
import { fotoDaMaravilha } from "../lib/maravilhaFotos";
import SobreNosCarousel from "../components/SobreNosCarousel";

const diferenciais = [
  {
    icon: Mapa,
    titulo: "Coordenadas e mapa",
    texto: "Cada maravilha tem coordenadas exatas, mapa incorporado e link de rota para você chegar lá.",
  },
  {
    icon: BookOpen,
    titulo: "História detalhada",
    texto: "Um artigo para cada lugar: quem construiu, quando, como e por que ele ficou famoso.",
  },
  {
    icon: Landmark,
    titulo: "Maravilhas antigas",
    texto: "Um panorama das sete obras do mundo antigo e o que restou de cada uma delas.",
  },
  {
    icon: Compass,
    titulo: "Redes oficiais",
    texto: "Links para os perfis oficiais de cada local, quando disponíveis, para acompanhar novidades.",
  },
];

// Carousel do topo: fotos das maravilhas (src/lib/maravilhaFotos.ts). Sem fotos, usa o placeholder.
const maravilhas = (await getCollection("maravilhas")).sort((a, b) => a.data.ordem - b.data.ordem);
const slides = await Promise.all(
  maravilhas
    .flatMap((m) => {
      const foto = fotoDaMaravilha(m.data.id);
      return foto ? [{ foto, nome: m.data.nome }] : [];
    })
    .map(async ({ foto, nome }) => {
      const img = await getImage({ src: foto, width: 880 });
      return { src: img.src, alt: `${nome}` };
    })
);
---

<Layout
  title="Sobre Nós — Maravilhas do Mundo"
  description="Conheça o projeto Maravilhas do Mundo e como reunimos história, coordenadas e redes oficiais das Sete Maravilhas do Mundo Moderno."
  path="/sobre-nos"
>
  <section class="mx-auto max-w-7xl px-4 py-10 lg:px-8">
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-texto/60">
      <a href={url("/")} class="cursor-pointer hover:text-primaria">Home</a> <span aria-hidden="true">›</span> Sobre Nós
    </nav>

    <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
      {slides.length > 0 ? (
        <SobreNosCarousel client:visible slides={slides} />
      ) : (
        <PlaceholderImage alt="Fotos das Sete Maravilhas do Mundo Moderno" ratio="wide" class="w-full" />
      )}
      <div>
        <p class="kicker">Quem somos</p>
        <h1 class="section-title">Sobre Nós</h1>
        <p class="text-texto">
          O Maravilhas do Mundo nasceu para reunir, em um só lugar, a história, a localização e as redes oficiais
          das Sete Novas Maravilhas do Mundo, eleitas em 2007: Chichén Itzá, Cristo Redentor, Machu Picchu,
          Coliseu, Taj Mahal, Muralha da China e Petra. Também contamos a história das maravilhas do mundo antigo,
          com uma meta simples: explicar tudo de forma clara e despertar a vontade de conhecer cada lugar.
        </p>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="mx-auto max-w-7xl px-4 py-16 lg:px-8">
      <p class="kicker">Por que acompanhar</p>
      <h2 class="section-title">O que você encontra aqui</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        {diferenciais.map((d) => {
          const Icon = d.icon;
          return (
            <div class="card flex flex-col items-center text-center">
              <span class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primaria/10 text-primaria">
                <Icon className="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="text-base font-bold">{d.titulo}</h3>
              <p class="mt-1 text-sm text-texto/80">{d.texto}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <script>
    import { revealOnScroll } from "../lib/animations";
    revealOnScroll();
  </script>
</Layout>
